---
import Muestra from './Muestra.astro';
import { empresa, telUrl } from '../data/empresa';
---
<section id="muestra" aria-labelledby="hero-t" class="scroll-mt-20">
  <div class="mx-auto grid max-w-[90rem] items-center gap-12 px-4 pb-20 pt-12 sm:px-8 lg:grid-cols-12 lg:pb-28 lg:pt-20">
    <div class="lg:col-span-5">
      <p class="label flex items-center gap-3 text-veta-fosc" data-reveal><span class="h-px w-10 bg-veta" aria-hidden="true"></span>Marmolistas · Empresa familiar</p>
      <h1 id="hero-t" class="display mt-6 text-[clamp(3.2rem,7.5vw,6.8rem)]" data-reveal style="--i:1">
        Piedra cortada <span class="text-veta">a la medida</span> de tu casa.
      </h1>
      <p class="mt-7 max-w-md text-lg text-ink-2" data-reveal style="--i:2">
        Encimeras de cocina, baños, escaleras y revestimientos en mármol, granito, piedra natural y porcelánico. Desde nuestro taller de Montcada i Reixac.
      </p>
      <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--i:3">
        <a href={telUrl} class="btn btn-ink tabular-nums">Pide presupuesto · {empresa.phone.display}</a>
        <a href="#trabajos" class="btn btn-line">Ver trabajos</a>
      </div>
    </div>
    <div class="lg:col-span-7" data-reveal style="--i:2">
      <Muestra />
    </div>
  </div>
</section>
