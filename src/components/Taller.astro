---
import { empresa, telUrl } from '../data/empresa';
---
<section id="taller" aria-labelledby="taller-t" class="scroll-mt-20 border-t border-line bg-paper-2">
  <div class="mx-auto grid max-w-[90rem] gap-12 px-4 py-20 sm:px-8 sm:py-28 lg:grid-cols-12">
    <div class="min-w-0 lg:col-span-6">
      <p class="label text-veta-fosc" data-reveal>El taller</p>
      <h2 id="taller-t" class="display mt-4 text-[clamp(2.8rem,6vw,5rem)]" data-reveal style="--i:1">Ven a ver la piedra antes de elegirla.</h2>
      <p class="mt-6 max-w-md text-lg text-ink-2" data-reveal style="--i:2">Cada placa es distinta. Llámanos, cuéntanos qué necesitas y te damos presupuesto.</p>
      <address class="mt-10 not-italic text-2xl leading-snug" data-reveal style="--i:3">
        {empresa.street}<br />{empresa.postalCode} {empresa.city}
      </address>
      <a href={empresa.maps} target="_blank" rel="noopener" class="mt-4 inline-block border-b-2 border-veta pb-1 font-semibold" data-reveal style="--i:4">Cómo llegar ↗</a>
    </div>
    <div class="grid min-w-0 content-start gap-3 lg:col-span-5 lg:col-start-8">
      <a href={telUrl} class="group flex items-center justify-between bg-ink p-7 text-paper transition-colors hover:bg-black" data-reveal>
        <span><span class="label block text-paper/60">Teléfono</span><span class="display mt-1 block text-4xl tabular-nums">{empresa.phone.display}</span></span>
        <span aria-hidden="true" class="text-3xl transition-transform group-hover:translate-x-1">→</span>
      </a>
      <a href={`mailto:${empresa.email}`} class="group flex min-w-0 items-center justify-between gap-4 border border-line bg-paper p-7 transition-colors hover:border-ink" data-reveal style="--i:1">
        <span class="min-w-0"><span class="label block text-ink-2">Email</span><span class="mt-1 block truncate text-lg font-semibold">{empresa.email}</span></span>
        <span aria-hidden="true" class="text-2xl">→</span>
      </a>
      <div class="grid grid-cols-2 gap-3" data-reveal style="--i:2">
        <a href={empresa.instagram} target="_blank" rel="noopener" class="border border-line bg-paper p-5 font-semibold transition-colors hover:border-ink">Instagram ↗</a>
        <a href={empresa.facebook} target="_blank" rel="noopener" class="border border-line bg-paper p-5 font-semibold transition-colors hover:border-ink">Facebook ↗</a>
      </div>
    </div>
  </div>
</section>
